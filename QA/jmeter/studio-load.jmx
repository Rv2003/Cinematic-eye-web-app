<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Cinematic Eye - Studio API Load Test Plan">
      <stringProp name="TestPlan.comments">Local/staging API workload model. Use only a dedicated test database. Scenarios:
- Scenario A: Visitor (70% traffic share)
- Scenario B: Client (20% traffic share)
- Scenario C: Booking User (8% traffic share)
- Scenario D: Admin (2% traffic share)

Defaults: 50 virtual users, 60 second ramp-up, 600 second duration, loopback host. Response-time assertion defaults to 5000 ms and can be changed with -JmaxResponseMs.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="host" elementType="Argument">
            <stringProp name="Argument.name">host</stringProp>
            <stringProp name="Argument.value">${__P(host,127.0.0.1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Target API Hostname or IP</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">${__P(port,5500)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Target API Port</stringProp>
          </elementProp>
          <elementProp name="protocol" elementType="Argument">
            <stringProp name="Argument.name">protocol</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">HTTP or HTTPS protocol</stringProp>
          </elementProp>
          <elementProp name="users" elementType="Argument">
            <stringProp name="Argument.name">users</stringProp>
            <stringProp name="Argument.value">${__P(users,50)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Base total concurrent users</stringProp>
          </elementProp>
          <elementProp name="ramp" elementType="Argument">
            <stringProp name="Argument.name">ramp</stringProp>
            <stringProp name="Argument.value">${__P(ramp,60)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Ramp-up time in seconds</stringProp>
          </elementProp>
          <elementProp name="duration" elementType="Argument">
            <stringProp name="Argument.name">duration</stringProp>
            <stringProp name="Argument.value">${__P(duration,600)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Test duration in seconds</stringProp>
          </elementProp>
          <elementProp name="csvPath" elementType="Argument">
            <stringProp name="Argument.name">csvPath</stringProp>
            <stringProp name="Argument.value">${__P(csvPath,${__groovy(import org.apache.jmeter.services.FileServer; new File(FileServer.getFileServer().getBaseDir()\, &quot;users.csv&quot;).exists() ? new File(FileServer.getFileServer().getBaseDir()\, &quot;users.csv&quot;).getAbsolutePath() : &quot;users.csv&quot;)})}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Path to 50 test users CSV file</stringProp>
          </elementProp>
          <elementProp name="adminEmail" elementType="Argument">
            <stringProp name="Argument.name">adminEmail</stringProp>
            <stringProp name="Argument.value">${__P(adminEmail,admin@cinematiceye.com)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Seeded Administrator Email</stringProp>
          </elementProp>
          <elementProp name="adminPassword" elementType="Argument">
            <stringProp name="Argument.name">adminPassword</stringProp>
            <stringProp name="Argument.value">${__P(adminPassword,AdminPass123!)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Seeded Administrator Password</stringProp>
          </elementProp>
          <elementProp name="users_visitor" elementType="Argument">
            <stringProp name="Argument.name">users_visitor</stringProp>
            <stringProp name="Argument.value">${__P(users_visitor,${__groovy(Math.max(1\, (int)Math.round(Integer.parseInt(props.get(&apos;users&apos;) ?: &apos;50&apos;) * 0.70)))})}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="users_client" elementType="Argument">
            <stringProp name="Argument.name">users_client</stringProp>
            <stringProp name="Argument.value">${__P(users_client,${__groovy(Math.max(1\, (int)Math.round(Integer.parseInt(props.get(&apos;users&apos;) ?: &apos;50&apos;) * 0.20)))})}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="users_booking" elementType="Argument">
            <stringProp name="Argument.name">users_booking</stringProp>
            <stringProp name="Argument.value">${__P(users_booking,${__groovy(Math.max(1\, (int)Math.round(Integer.parseInt(props.get(&apos;users&apos;) ?: &apos;50&apos;) * 0.08)))})}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="users_admin" elementType="Argument">
            <stringProp name="Argument.name">users_admin</stringProp>
            <stringProp name="Argument.value">${__P(users_admin,${__groovy(Math.max(1\, (int)Math.round(Integer.parseInt(props.get(&apos;users&apos;) ?: &apos;50&apos;) * 0.02)))})}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <intProp name="HTTPSampler.connect_timeout">5000</intProp>
        <intProp name="HTTPSampler.response_timeout">15000</intProp>
        <stringProp name="HTTPSampler.domain">${host}</stringProp>
        <stringProp name="HTTPSampler.port">${port}</stringProp>
        <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation"></stringProp>
      </ConfigTestElement>
      <hashTree/>
      <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager" enabled="true">
        <collectionProp name="CookieManager.cookies"/>
        <boolProp name="CookieManager.clearEachIteration">false</boolProp>
        <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
      </CookieManager>
      <hashTree/>
